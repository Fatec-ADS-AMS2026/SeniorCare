# Copie para .env.local e ajuste — nunca commite o .env.local real (só este .example).
# Usado só pelo servidor de dev do Vite (proxy de /api); nunca entra no bundle publicado.
# Precisa ser uma URL completa (protocolo + host + porta).
VITE_API_PROXY_TARGET=http://localhost:8080

# Caminho-base do roteador/bundle (docs/architecture/senior-portal-contracts.md §1).
# Build-time. Default "/" preserva o deploy atual por subdomínio.
VITE_BASE_PATH=/
