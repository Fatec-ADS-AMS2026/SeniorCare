# Copie esta pasta para clients/<nome-real> e ajuste — nunca commite clients/<nome-real>/.env
# (só este .example fica no git). Ver infra/deploy/.gitignore.

POSTGRES_DB=db_seniorcare
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-esta-senha
# Loopback por padrão (só acessível via SSH tunnel). Para expor na LAN: 0.0.0.0:5432
POSTGRES_PUBLISH=127.0.0.1:5432
POSTGRES_DATA_PATH=/opt/seniorcare/postgres

# Origem(s) autorizada(s) a chamar a API, separadas por vírgula.
CORS_ALLOWED_ORIGINS=https://care.exemplo.com.br,https://estoque.exemplo.com.br

# Limite de RAM do container da API — ajuste conforme o servidor.
API_MEM_LIMIT=1g

# Bootstrap da instituição e do administrador inicial — as três juntas ou nenhuma.
# Só têm efeito enquanto NENHUMA instituição existir no banco (idempotente — em
# deploys seguintes, com a instituição já criada, ficam sem efeito e podem
# continuar aqui sem risco). Ver infra/deploy/BOOTSTRAP.md.
Bootstrap__InstitutionName=ILPI Exemplo
Bootstrap__AdminEmail=admin@exemplo.com.br
Bootstrap__AdminDisplayName=Administrador Inicial

# Opcional — só sobem com `docker compose --profile tools up`
PGADMIN_EMAIL=admin@exemplo.com.br
PGADMIN_PASSWORD=troque-esta-senha
PGADMIN_PORT=5050
