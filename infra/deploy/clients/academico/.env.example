# Copie para clients/academico/.env. Somente dados e destinos sintéticos.
# O deploy acadêmico usa o projeto Compose fixo seniorcare-academico.

POSTGRES_DB=db_seniorcare_academico
POSTGRES_USER=seniorcare_academico
POSTGRES_PASSWORD=troque-esta-senha-academica
ACADEMIC_POSTGRES_PUBLISH=127.0.0.1:5433
ACADEMIC_POSTGRES_DATA_PATH=/opt/seniorcare-academico/postgres
ACADEMIC_DATA_PROTECTION_PATH=/opt/seniorcare-academico/data-protection
ACADEMIC_DATA_PROTECTION_APPLICATION_NAME=seniorcare-academico
ACADEMIC_CADDY_DATA_PATH=/opt/seniorcare-academico/caddy-data
ACADEMIC_CADDY_CONFIG_PATH=/opt/seniorcare-academico/caddy-config
ACADEMIC_BACKUPS_PATH=/opt/seniorcare-academico/backups
ACADEMIC_NETWORK_SUBNET=172.30.0.0/24
ACADEMIC_CADDY_IP=172.30.0.2
ACADEMIC_NETWORK_NAME=seniorcare-academico-net

ACADEMIC_HOSTNAME=seniorcare.test
ACADEMIC_HTTPS_PUBLISH=8443
ACADEMIC_ACTIVATION_BASE_URL=https://seniorcare.test:8443/ativar-conta
CORS_ALLOWED_ORIGINS=https://seniorcare.test:8443
PUBLIC_NAME=SeniorCare Acadêmico
ACADEMIC_BANNER=Ambiente didático — dados fictícios

ACADEMIC_API_MEM_LIMIT=768m
ACADEMIC_CADDY_MEM_LIMIT=128m
ACADEMIC_MAILPIT_MEM_LIMIT=128m

# Mailpit recebe mensagens apenas na rede Docker; a UI fica no loopback.
ACADEMIC_MAILPIT_UI_PUBLISH=127.0.0.1:8025
ACADEMIC_SMTP_FROM_ADDRESS=noreply@seniorcare.example.test
ACADEMIC_SMTP_FROM_DISPLAY_NAME=SeniorCare Acadêmico

# Bootstrap inicial: use somente identidade fictícia. As três variáveis são
# idempotentes e não alteram uma instituição já existente.
Bootstrap__InstitutionName=Instituição Didática SeniorCare
Bootstrap__AdminEmail=admin@seniorcare.example.test
Bootstrap__AdminDisplayName=Administrador Acadêmico
# O bootstrap da carga acadêmica acontece somente por seed-academico.sh.
Bootstrap__RunOnStartup=false
