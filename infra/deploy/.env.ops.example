# Config do overlay de OPERAÇÃO (docker-compose.ops.yml).
# Copie para .env.ops e ajuste. NÃO comitar .env.ops (segredos).
#
#   cp .env.ops.example .env.ops && ./ops.sh up

# ── Ingress / TLS (Caddy) ────────────────────────────────────────────────
# Domínio-base para os subdomínios (api., care., stock.). Em LAN, aponte
# *.${OPS_DOMAIN} para o IP do servidor via DNS interno ou /etc/hosts.
OPS_DOMAIN=seniorcare.local
# Portas do Caddy. Default fora de 80/443 para NÃO conflitar com os frontends
# (3000/3001) na fase de avaliação. No cutover de produção, libere 80/443 removendo
# as publicações diretas de porta dos frontends na stack base e use 80/443 aqui.
CADDY_HTTP_PORT=8880
CADDY_HTTPS_PORT=8443

# ── Painel / logs ─────────────────────────────────────────────────────────
PORTAINER_PORT=9443
DOZZLE_PORT=8888

# ── Página de gestão (Homepage) — hub de links pra tudo numa porta só ────
HOMEPAGE_PORT=8090
# IP do servidor na LAN (usado nos atalhos do dashboard):
OPS_HOST=127.0.0.1
# Host(s) permitidos a abrir o Homepage (Host header) = IP:porta do dashboard:
HOMEPAGE_ALLOWED_HOSTS=127.0.0.1:8090

# ── Backup diário: dump do banco → um .zip/dia ────────────────────────────
# POSTGRES_* devem casar com o clients/<nome>/.env da stack base.
POSTGRES_HOST=seniorcare-postgres
POSTGRES_DB=db_seniorcare
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-me
# Horário do backup em cron (min hora dia mês dia-da-semana). Default: 02:00 todo dia.
BACKUP_SCHEDULE=0 2 * * *
# Retenção: apaga os .zip com mais de N dias.
BACKUP_KEEP_DAYS=14
# Fuso usado pelo cron e pelo carimbo de data.
TZ=America/Sao_Paulo
# Onde os .zip diários ficam no servidor.
OPS_BACKUP_PATH=./backups/scheduled
