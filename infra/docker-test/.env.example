# Copie para .env neste diretório e ajuste. Nunca commite o .env real (só este .example).
POSTGRES_DB=db_seniorcare
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-esta-senha

ASPNETCORE_ENVIRONMENT=Development

# Bootstrap da instituição e do administrador inicial — as três juntas ou nenhuma. Só
# têm efeito enquanto nenhuma instituição existir no banco. Ver infra/deploy/BOOTSTRAP.md.
Bootstrap__InstitutionName=ILPI Teste
Bootstrap__AdminEmail=admin@example.com
Bootstrap__AdminDisplayName=Administrador de Teste

# Opcional — só sobem com `docker compose --profile tools up`
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=troque-esta-senha
